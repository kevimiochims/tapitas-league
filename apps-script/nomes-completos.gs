// =============================================================================
// CONVERSÃO DOS NOMES ABREVIADOS PARA NOMES COMPLETOS — GAME_FACTS_ALL
// -----------------------------------------------------------------------------
// Rodar UMA vez: converteNomesCompletos()
//
// Troca os nomes abreviados ("R. Wilson") pelo nome completo do jogador
// ("Russell Wilson"), igual à coluna full_name da _PLAYER_CACHE, em todas as
// temporadas. Defesas continuam pelo apelido ("Broncos").
//
// Como cada nome foi identificado (calculado fora da planilha):
//   - 2024 a 2026: pelo elenco real de cada time no Sleeper, semana a semana;
//   - 2014 a 2023: pelos pontos de cada semana, comparados com as estatísticas
//     do Sleeper de todos os jogadores com aquela abreviação ("D. Johnson" que
//     fez 19,7 na semana 4 de 2021 é o Diontae, não o David). Semanas sem
//     pontos (bye, lesão) seguem o jogador que o time tinha nas outras semanas.
//
// Segurança:
//   - antes de mexer, copia a aba para "GAME_FACTS_ALL_BACKUP_NOMES" (se ainda
//     não existir). Depois de conferir o site, pode apagar essa cópia;
//   - só as colunas de nomes (S/B/OS/OB..._Name) são regravadas; pontos,
//     fórmulas e as demais colunas não são tocadas;
//   - rodar de novo não estraga nada: nomes já convertidos são ignorados.
//
// Também inclui na _PLAYER_CACHE os poucos jogadores antigos que faltavam nela.
// =============================================================================

function converteNomesCompletos() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const sheet = ss.getSheetByName('GAME_FACTS_ALL');
  if (!sheet) throw new Error('Aba GAME_FACTS_ALL não encontrada');

  const BACKUP = 'GAME_FACTS_ALL_BACKUP_NOMES';
  if (!ss.getSheetByName(BACKUP)) {
    sheet.copyTo(ss).setName(BACKUP);
    Logger.log('[NOMES] Backup criado na aba ' + BACKUP);
  }

  const values = sheet.getDataRange().getValues();
  const header = values[0].map(h => String(h || '').trim());
  const iSeason = header.indexOf('Season'), iWeek = header.indexOf('Week');
  const iTeam = header.indexOf('Team'), iOpp = header.indexOf('Opponent');
  const nameCols = header
    .map((h, i) => ({ h, i }))
    .filter(c => /^(S|B|OS|OB)\d+_Name$/.test(c.h));

  const map = NOMES_COMPLETOS_MAPA_;
  const exc = {};
  NOMES_COMPLETOS_EXCECOES_.forEach(([s, w, t, c, o, n]) => { exc[[s, w, t, c, o].join('|')] = n; });

  let changed = 0;
  nameCols.forEach(({ h, i }) => {
    let dirty = false;
    const column = values.slice(1).map(row => {
      const raw = row[i];
      const old = String(raw == null ? '' : raw).trim();
      if (!old) return [raw];
      const season = String(row[iSeason]).trim();
      const week = String(row[iWeek]).trim();
      const rowTeam = String(row[iTeam]).trim();
      const team = h.charAt(0) === 'O' ? String(row[iOpp]).trim() : rowTeam;
      const byTeam = (map[season] || {})[team] || {};
      const next = exc[[season, week, rowTeam, h, old].join('|')] || byTeam[old] || old;
      if (next !== raw) { dirty = true; if (next !== old) changed++; }
      return [next];
    });
    if (dirty) sheet.getRange(2, i + 1, column.length, 1).setValues(column);
  });
  Logger.log('[NOMES] ' + changed + ' nomes convertidos para o nome completo.');

  // Jogadores antigos que não estavam na _PLAYER_CACHE
  const cache = ss.getSheetByName('_PLAYER_CACHE');
  if (cache) {
    const data = cache.getDataRange().getValues();
    const head = data[0].map(h => String(h || '').trim().toLowerCase());
    const idx = k => head.indexOf(k);
    const have = new Set(data.slice(1).map(r => String(r[idx('player_id')])));
    const rows = NOMES_COMPLETOS_CACHE_NOVOS_
      .filter(([id]) => !have.has(id))
      .map(([id, full, pos, name]) => head.map(k => ({ player_id: id, full_name: full, position: pos, name: name })[k] ?? ''));
    if (rows.length) {
      cache.getRange(cache.getLastRow() + 1, 1, rows.length, head.length).setValues(rows);
      Logger.log('[NOMES] ' + rows.length + ' jogadores incluídos na _PLAYER_CACHE.');
    }
  }
}

